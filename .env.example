# -----------------------------
# Core runtime
# -----------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Use long, random values (at least 32 characters). Never commit real production secrets.
JWT_SECRET=replace_with_a_random_64_character_access_secret
REFRESH_SECRET=replace_with_a_random_64_character_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# -----------------------------
# MySQL
# -----------------------------
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=vega_app
DB_PASSWORD=replace_me
DB_NAME=talentbridge
DB_POOL_SIZE=30
DB_POOL_MAX_IDLE=15

# -----------------------------
# Redis / BullMQ / distributed signaling
# -----------------------------
REDIS_URL=redis://127.0.0.1:6379/0
AI_WORKER_CONCURRENCY=2

# -----------------------------
# Object storage (required in production for user uploads)
# -----------------------------
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your-private-bucket
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me

# -----------------------------
# AI
# -----------------------------
GEMINI_API_KEY=replace_me

# -----------------------------
# SMTP
# -----------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=replace_me

# -----------------------------
# Razorpay
# -----------------------------
RAZORPAY_KEY_ID=replace_me
RAZORPAY_KEY_SECRET=replace_me
VITE_RAZORPAY_KEY_ID=replace_me

# Reminder window in hours before a job post/pipeline ends
JOB_END_REMINDER_HOURS=24
SHUTDOWN_GRACE_MS=15000
SLOW_QUERY_MS=500
REQUIRE_AI=true
REQUIRE_EMAIL=true
REQUIRE_OBJECT_STORAGE=true
REQUIRE_TURN=true

# -----------------------------
# Phase 2 session / observability
# -----------------------------
REFRESH_COOKIE_NAME=vega_refresh
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_MAX_AGE_MS=604800000
# COOKIE_DOMAIN=.yourdomain.com
TRUST_PROXY_HOPS=1
SERVICE_NAME=vega-api
METRICS_ENABLED=true
# Protect /internal/metrics when it is reachable outside a private network.
METRICS_TOKEN=replace_with_random_metrics_bearer_token

# -----------------------------
# WebRTC TURN (required for reliable production interviews)
# Coturn REST API/shared-secret mode is preferred over static credentials.
# -----------------------------
TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_SHARED_SECRET=replace_with_coturn_shared_secret
TURN_CREDENTIAL_TTL_SECONDS=3600
# Static fallback only when your TURN provider requires it:
# TURN_USERNAME=
# TURN_CREDENTIAL=

# -----------------------------
# Phase 4 runtime tuning
# -----------------------------
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_MAX_REQUESTS_PER_SOCKET=1000
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
EMAIL_WORKER_CONCURRENCY=4

# Phase 5 - database performance / Redis cache
DB_POOL_SIZE=30
DB_POOL_MAX_IDLE=15
# Optional read replica. Leave blank until replication is configured and monitored.
MYSQL_READ_URL=
DB_READ_POOL_SIZE=20
DB_READ_POOL_MAX_IDLE=10
SLOW_QUERY_MS=300
DB_MAX_QUERIES_PER_REQUEST=30
CACHE_TTL_JOBS_SECONDS=60
CACHE_TTL_JOB_MATCH_SECONDS=20
CACHE_TTL_DASHBOARD_SECONDS=30

# Phase 6 - MySQL production performance / safety
# Keep application pool capacity below the server's max_connections after accounting for workers,
# migrations, monitoring, admin sessions, and failover headroom.
DB_POOL_QUEUE_LIMIT=500
DB_READ_POOL_QUEUE_LIMIT=500
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000
DB_LOCK_WAIT_TIMEOUT_SECONDS=15
DB_MAX_EXECUTION_MS=5000
DB_READ_MAX_EXECUTION_MS=3000
DB_MAINTENANCE_BATCH_SIZE=5000
DB_REFRESH_PIPELINE_SUMMARY=true
DB_PIPELINE_SUMMARY_REFRESH_MINUTES=15
# MYSQL_READ_URL=mysql://readonly_user:password@read-replica:3306/talentbridge01
