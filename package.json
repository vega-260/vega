{
  "name": "vega-talent-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:server && npm run build:worker && npm run build:migrate",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:worker": "esbuild worker.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/worker.cjs",
    "start:worker": "node dist/worker.cjs",
    "build:migrate": "esbuild migrate.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/migrate.cjs",
    "migrate:prod": "node dist/migrate.cjs",
    "test": "node --test tests/*.test.mjs",
    "test:hardening": "node --test tests/*.test.mjs",
    "loadtest:smoke": "k6 run load-tests/smoke.js",
    "loadtest:api": "k6 run load-tests/api-journey.js",
    "loadtest:company": "k6 run load-tests/company-pipeline.js",
    "loadtest:production": "k6 run load-tests/production-readiness.js",
    "db:audit": "tsx scripts/ops/db-performance-audit.ts",
    "loadtest:db": "k6 run load-tests/database-hotpaths.js",
    "db:schema-health": "tsx scripts/ops/db-schema-health.ts",
    "db:explain-critical": "tsx scripts/ops/db-explain-critical.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1061.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.51.0",
    "@mediapipe/face_detection": "^0.4.1646425229",
    "@tailwindcss/vite": "^4.1.14",
    "@tensorflow-models/face-detection": "^1.0.3",
    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "bullmq": "^5.78.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.0",
    "formik": "^2.4.9",
    "helmet": "^8.1.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.0.9",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "leetcode-apis": "^1.0.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "mysql2": "^3.22.3",
    "nodemailer": "^8.0.7",
    "opossum": "^9.0.0",
    "papaparse": "^5.5.4",
    "pdf-parse": "^2.4.5",
    "profile-stats": "^0.2.1",
    "proxor": "^1.2.0",
    "razorpay": "^2.9.6",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.6",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vite": "^6.2.3",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5",
    "yup": "^1.7.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@img/sharp-libvips-win32-x64": "1.3.2",
    "@img/sharp-linux-x64": "0.35.3",
    "@img/sharp-win32-x64": "0.35.3"
  }
}
