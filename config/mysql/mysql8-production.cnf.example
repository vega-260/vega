# VEGA / TalentBridge MySQL 8 production baseline.
# Example assumes a dedicated ~8 GiB MySQL host. Recalculate memory before use.
# Managed RDS/Cloud SQL users should map these to parameter-group equivalents.
[mysqld]
# Core durability / charset
character-set-server=utf8mb4
collation-server=utf8mb4_0900_ai_ci
default-storage-engine=InnoDB
sql_mode=STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
transaction_isolation=READ-COMMITTED
innodb_flush_log_at_trx_commit=1
sync_binlog=1

# InnoDB memory: normally 60-70% of RAM on a dedicated DB host.
# 5G is an 8 GiB-host example, NOT a universal value.
innodb_buffer_pool_size=5G
innodb_buffer_pool_instances=4
innodb_redo_log_capacity=2G
innodb_log_buffer_size=64M
innodb_flush_method=O_DIRECT
innodb_file_per_table=ON

# I/O. Tune to measured storage IOPS. Start conservatively on SSD/NVMe.
innodb_io_capacity=2000
innodb_io_capacity_max=4000
innodb_read_io_threads=8
innodb_write_io_threads=8

# Connection protection. Application pools are intentionally bounded as well.
max_connections=300
max_connect_errors=10000
thread_cache_size=100
wait_timeout=600
interactive_timeout=600
connect_timeout=10

# Per-session buffers stay modest; large values multiply by concurrent sessions.
sort_buffer_size=2M
join_buffer_size=2M
read_buffer_size=1M
read_rnd_buffer_size=1M
tmp_table_size=64M
max_heap_table_size=64M
max_allowed_packet=64M

# Query safety / diagnostics
slow_query_log=ON
long_query_time=0.5
log_queries_not_using_indexes=OFF
min_examined_row_limit=1000
performance_schema=ON
performance_schema_consumer_events_statements_history_long=ON

# Table / metadata caches
table_open_cache=4000
table_definition_cache=2000
open_files_limit=65535

# Binary logging / point-in-time recovery. Retention is an operational decision.
binlog_format=ROW
binlog_expire_logs_seconds=604800

# Replica recommendations should be set on replica instances only:
# read_only=ON
# super_read_only=ON
# relay_log_recovery=ON
